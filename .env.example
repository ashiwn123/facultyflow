# Copy to .env. Never commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret
MONGODB_URI=
MONGODB_DB=facultyflow
# true uses temporary in-memory demo data; false requires MongoDB.
DEMO_MODE=true
COOKIE_SECURE=false
STAFF_LEAVE_SLOTS=3
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Development only: print recovery codes in the local terminal.
OTP_CONSOLE=true
